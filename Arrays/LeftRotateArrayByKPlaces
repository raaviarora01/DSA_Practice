/* Given an integer array nums and a non-negative integer k, rotate the array to the left by k steps. */

public class LeftRotateArrayByKPlaces {

    /* Brute Force Approach: Rotates the array to the left by k steps
     * Time Complexity: O(n*k) - The method iterates through the input array k times, and each iteration takes O(n) time.
    * Space Complexity: O(1) - The method uses a constant amount of space for variables.
    */
    public void rotateBruteForce(int[] nums, int k) {
        int n = nums.length;
        k = k%n;
        while(k > 0){
            int temp = nums[0];
            for(int i = 0; i < n - 1; i++) {
                nums[i] = nums[i + 1];
            }
            nums[n-1] = temp;
            k--;
        }
    }

    /* Better Approach: Rotates the array to the right by k steps using extra space
    * Time Complexity: O(n) - The method iterates through the input array once.
    * Space Complexity: O(k) - The method uses additional space proportional to k.
    */
    public void rotateBetter(int[] nums, int k) {
        int n = nums.length;
        k = k%n;
        
        int temp[] = new int[k];
        int j=0;

        for(int i=0; i<k; i++){
            temp[j] = nums[i];
            j++;
        }

        for(int i=k; i<n; i++){
            nums[i-k] = nums[i];
        }

        for(int i=0; i<k; i++){
            nums[n-k+i] = temp[i];
        }
    }


    /* Optimal Approach: Rotates the array to the left by k steps using reversal
     * Time Complexity: O(n) - The method iterates through the input array a constant number of times.
     * Space Complexity: O(1) - The method uses a constant amount of space for variables.
     */
    public void rotateOptimal(int[] nums, int k) {
        int n = nums.length;
        k = k%n;
        reverse(nums, 0, k-1);
        reverse(nums, k, n-1);
        reverse(nums, 0, n-1);
    }

    public static void reverse(int nums[], int left, int right){
        while(left < right){
            int temp = nums[left];
            nums[left] = nums[right];
            nums[right] = temp;
            left++;
            right--;
        }
    }
}