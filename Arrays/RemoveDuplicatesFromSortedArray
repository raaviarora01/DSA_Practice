/* Given an integer array nums sorted in non-decreasing order, remove the duplicates in-place such that each unique element appears only once. The relative order of the elements should be kept the same.

Consider the number of unique elements in nums to be k​​​​​​​​​​​​​​. After removing duplicates, return the number of unique elements k.

The first k elements of nums should contain the unique numbers in sorted order. The remaining elements beyond index k - 1 can be ignored. */

public class RemoveDuplicatesFromSortedArray {


    /* Removes duplicates from a sorted array using a HashSet and returns the new length of the array.
        * This method uses a LinkedHashSet to maintain the order of elements while removing duplicates.
     * Time Complexity: O(n) - The method iterates through the input array once.
     * Space Complexity: O(n) - The method uses additional space for the HashSet.
     */
    public int removeDuplicatesBruteForce(int[] nums) {
        if(nums.length == 0) return 0;

        Set<Integer> unique = new LinkedHashSet<>();

        for(int num : nums){
            unique.add(num);
        }

        int i=0;
        for(int num : unique){
            nums[i] = num;
            i++;
        }

        return unique.size();
    }

    /* Removes duplicates from a sorted array using extra space and returns the new length of the array.
     * Time Complexity: O(n) - The method iterates through the input array once.
     * Space Complexity: O(n) - The method uses additional space for the temporary array.
     */
    public int removeDuplicatesExtraSpace(int[] nums) {
        if(nums.length == 0) return 0;
        int temp[] = new int[nums.length];
        int j=0;

        for(int i=0; i<nums.length-1; i++){
            if(nums[i] != nums[i+1]){
                temp[j] = nums[i];
                j++;
            }
        }
        temp[j] = nums[nums.length-1];

        for(int i=0; i<=j; i++){
            nums[i] = temp[i];
        }

        return j+1;
    }

    /** Removes duplicates from a sorted array in-place and returns the new length of the array.
     * Time Complexity: O(n) - The method iterates through the input array once.
     * Space Complexity: O(1) - The method uses a constant amount of space for variables.
     */
    public int removeDuplicates(int[] nums) {
        if (nums.length == 0) return 0;

        int uniqueCount = 1; // Start with the first element as unique

        for (int i = 1; i < nums.length; i++) {
            if (nums[i] != nums[i - 1]) {
                nums[uniqueCount] = nums[i];
                uniqueCount++;
            }
        }

        return uniqueCount;
    }
}